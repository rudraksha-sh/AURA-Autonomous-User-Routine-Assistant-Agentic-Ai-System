AURA_HOST=aura.example.com
AURA_PUBLIC_ORIGIN=https://aura.example.com
AURA_BIND_ADDRESS=127.0.0.1
AURA_HTTP_PORT=80
AURA_HTTPS_PORT=443
AURA_TLS_ISSUER=ops@example.invalid
AURA_SECRETS_DIR=/etc/aura/secrets
AURA_IMAGE_TAG=local
AURA_SMTP_HOST=smtp.example.com
AURA_SMTP_PORT=587
AURA_SMTP_USERNAME=
AURA_EMAIL_FROM=AURA <accounts@example.com>
AURA_GOOGLE_CLIENT_ID=
