import time
from datetime import datetime, timezone
from types import SimpleNamespace
from unittest.mock import MagicMock, patch

import pytest
from sqlalchemy import select
from sqlalchemy.orm import Session

from app.core.security import create_access_token
from app.integrations.google.client import (
    create_google_flow,
    exchange_google_code,
    get_google_user_info,
)
from app.integrations.google.oauth import (
    GOOGLE_AUTHORIZATION_ENDPOINT,
    GOOGLE_OAUTH_SCOPES,
    OAuthStateStore,
    build_google_authorization_url,
    oauth_state_store,
)
from app.models.integration import Integration
from app.models.user import User
from tests.conftest import test_engine


# ============================================================
# OAuth State Store Tests
# ============================================================


def test_oauth_state_create_and_consume():
    store = OAuthStateStore(ttl_seconds=60)

    state = store.create(user_id=42)

    assert state
    assert store.consume(state) == 42


def test_oauth_state_is_single_use():
    store = OAuthStateStore(ttl_seconds=60)

    state = store.create(user_id=42)

    assert store.consume(state) == 42
    assert store.consume(state) is None


def test_oauth_state_rejects_unknown_state():
    store = OAuthStateStore(ttl_seconds=60)

    assert store.consume("invalid-state") is None


def test_oauth_state_expires():
    store = OAuthStateStore(ttl_seconds=1)

    state = store.create(user_id=42)

    time.sleep(1.1)

    assert store.consume(state) is None


def test_oauth_state_rejects_invalid_ttl():
    with pytest.raises(ValueError):
        OAuthStateStore(ttl_seconds=0)


# ============================================================
# Google Authorization URL Tests
# ============================================================


def test_google_authorization_url_contains_required_parameters():
    state = "test-state"

    url = build_google_authorization_url(state)

    assert url.startswith(GOOGLE_AUTHORIZATION_ENDPOINT)
    assert "client_id=" in url
    assert "redirect_uri=" in url
    assert "response_type=code" in url
    assert "state=test-state" in url
    assert "access_type=offline" in url
    assert "prompt=consent" in url


def test_google_oauth_scopes_include_required_services():
    assert "openid" in GOOGLE_OAUTH_SCOPES
    assert (
        "https://www.googleapis.com/auth/userinfo.email"
        in GOOGLE_OAUTH_SCOPES
    )
    assert (
        "https://www.googleapis.com/auth/gmail.readonly"
        in GOOGLE_OAUTH_SCOPES
    )
    assert (
        "https://www.googleapis.com/auth/calendar.readonly"
        in GOOGLE_OAUTH_SCOPES
    )
    assert (
        "https://www.googleapis.com/auth/drive.readonly"
        in GOOGLE_OAUTH_SCOPES
    )


# ============================================================
# Google Connect Endpoint Tests
# ============================================================


def test_google_connect_requires_authentication(client):
    response = client.get(
        "/api/integrations/google/connect",
    )

    assert response.status_code == 401
    assert response.json()["message"] == "Could not validate credentials"


def test_google_connect_returns_authorization_url(client):
    registration = client.post(
        "/api/auth/register",
        json={
            "email": "google-connect@example.com",
            "password": "TestPassword@123",
            "name": "Google Connect User",
        },
    )
    assert registration.status_code == 201
    token = create_access_token({"sub": "1"})

    response = client.get(
        "/api/integrations/google/connect",
        headers={"Authorization": f"Bearer {token}"},
    )

    assert response.status_code == 200

    data = response.json()

    assert "authorization_url" in data

    assert data["authorization_url"].startswith(
        "https://accounts.google.com/o/oauth2/v2/auth?"
    )


# ============================================================
# Google Client Tests
# ============================================================


def test_create_google_flow():
    flow = create_google_flow()

    assert (
        flow.redirect_uri
        == "http://localhost:8000/api/integrations/google/callback"
    )

    assert flow.client_config["client_id"]


@patch("app.integrations.google.client.create_google_flow")
def test_exchange_google_code(mock_create_flow):
    mock_flow = MagicMock()
    mock_create_flow.return_value = mock_flow

    credentials = MagicMock()
    mock_flow.credentials = credentials

    result = exchange_google_code("test-authorization-code")

    mock_flow.fetch_token.assert_called_once_with(
        code="test-authorization-code"
    )

    assert result is credentials


@patch("app.integrations.google.client.build")
def test_get_google_user_info(mock_build):
    mock_service = MagicMock()
    mock_build.return_value = mock_service

    mock_service.userinfo.return_value.get.return_value.execute.return_value = {
        "id": "google-user-123",
        "email": "user@example.com",
        "verified_email": True,
    }

    credentials = MagicMock()

    result = get_google_user_info(credentials)

    mock_build.assert_called_once_with(
        "oauth2",
        "v2",
        credentials=credentials,
        cache_discovery=False,
    )

    assert result["id"] == "google-user-123"
    assert result["email"] == "user@example.com"


# ============================================================
# Google Callback Validation Tests
# ============================================================


def test_google_callback_requires_state(client):
    response = client.get(
        "/api/integrations/google/callback",
        params={"code": "test-code"},
    )

    assert response.status_code == 400
    assert response.json()["message"] == "Missing OAuth state"


def test_google_callback_rejects_invalid_state(client):
    response = client.get(
        "/api/integrations/google/callback",
        params={
            "code": "test-code",
            "state": "invalid-state",
        },
    )

    assert response.status_code == 400
    assert (
        response.json()["message"]
        == "Invalid or expired OAuth state"
    )


def test_google_callback_requires_code(client):
    state = oauth_state_store.create(1)

    response = client.get(
        "/api/integrations/google/callback",
        params={"state": state},
    )

    assert response.status_code == 400
    assert response.json()["message"] == "Missing authorization code"


def test_google_callback_handles_google_denial(client):
    response = client.get(
        "/api/integrations/google/callback",
        params={
            "error": "access_denied",
            "state": "anything",
        },
    )

    assert response.status_code == 400
    assert (
        "Google authorization failed"
        in response.json()["message"]
    )


# ============================================================
# Google Callback Persistence Test
# ============================================================


def test_google_callback_persists_integration(
    client,
    monkeypatch,
):
    with Session(test_engine) as db:
        user = User(
            email="oauth-success@example.com",
            password_hash="test-password-hash",
            name="OAuth Test User",
        )

        db.add(user)
        db.commit()
        db.refresh(user)

        user_id = user.id

    state = oauth_state_store.create(user_id)

    credentials = SimpleNamespace(
        token="mock-access-token",
        refresh_token="mock-refresh-token",
        expiry=datetime.now(timezone.utc),
        scopes=[
            "openid",
            "https://www.googleapis.com/auth/gmail.readonly",
        ],
    )

    monkeypatch.setattr(
        "app.api.routes.integrations.exchange_google_code",
        lambda code: credentials,
    )

    monkeypatch.setattr(
        "app.api.routes.integrations.get_google_user_info",
        lambda credentials: {
            "id": "google-account-123",
            "email": "oauth-success@example.com",
        },
    )

    response = client.get(
        "/api/integrations/google/callback",
        params={
            "code": "mock-authorization-code",
            "state": state,
        },
        follow_redirects=False,
    )

    assert response.status_code == 303
    assert response.headers["location"].startswith(
        "http://localhost:3000/settings?google=connected"
    )

    assert response.json() == {
        "status": "connected",
        "provider": "google",
        "provider_account_id": "google-account-123",
    }

    with Session(test_engine) as db:
        integration = db.scalar(
            select(Integration).where(
                Integration.user_id == user_id,
                Integration.provider == "google",
            )
        )

        assert integration is not None

        assert (
            integration.provider_account_id
            == "google-account-123"
        )

        assert (
            integration.access_token
            == "mock-access-token"
        )

        assert (
            integration.refresh_token
            == "mock-refresh-token"
        )

        assert integration.scopes == (
            "openid "
            "https://www.googleapis.com/auth/gmail.readonly"
        )
