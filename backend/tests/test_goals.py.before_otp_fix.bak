from tests.conftest import register_and_verify_email


def register_and_login(client, email="goal-user@example.com", caplog=None):
    assert caplog is not None
    response = register_and_verify_email(
        client,
        caplog,
        email,
        "TestPassword@123",
        "Goal Test User",
    )
    assert response.status_code == 200, response.text
    return response.json()["access_token"]


def auth_headers(token):
    return {
        "Authorization": f"Bearer {token}",
    }


def create_goal(client, token, title="Test Goal"):
    response = client.post(
        "/api/goals",
        headers=auth_headers(token),
        json={
            "title": title,
            "description": "Goal created during automated testing",
            "status": "active",
            "priority": "medium",
        },
    )

    assert response.status_code == 201

    return response.json()


def test_create_goal(client):
    token = register_and_login(client)

    goal = create_goal(client, token)

    assert goal["title"] == "Test Goal"
    assert goal["description"] == "Goal created during automated testing"
    assert goal["status"] == "active"
    assert goal["priority"] == "medium"


def test_get_goals(client):
    token = register_and_login(client)

    create_goal(client, token, "Goal One")
    create_goal(client, token, "Goal Two")

    response = client.get(
        "/api/goals",
        headers=auth_headers(token),
    )

    assert response.status_code == 200

    goals = response.json()

    assert len(goals) == 2
    assert goals[0]["title"] == "Goal One"
    assert goals[1]["title"] == "Goal Two"


def test_get_single_goal(client):
    token = register_and_login(client)

    goal = create_goal(client, token)

    response = client.get(
        f"/api/goals/{goal['id']}",
        headers=auth_headers(token),
    )

    assert response.status_code == 200

    data = response.json()

    assert data["id"] == goal["id"]
    assert data["title"] == "Test Goal"


def test_update_goal(client):
    token = register_and_login(client)

    goal = create_goal(client, token)

    response = client.patch(
        f"/api/goals/{goal['id']}",
        headers=auth_headers(token),
        json={
            "title": "Updated Goal",
            "priority": "high",
            "status": "completed",
        },
    )

    assert response.status_code == 200

    data = response.json()

    assert data["title"] == "Updated Goal"
    assert data["priority"] == "high"
    assert data["status"] == "completed"


def test_delete_goal(client):
    token = register_and_login(client)

    goal = create_goal(client, token)

    response = client.delete(
        f"/api/goals/{goal['id']}",
        headers=auth_headers(token),
    )

    assert response.status_code == 204

    get_response = client.get(
        f"/api/goals/{goal['id']}",
        headers=auth_headers(token),
    )

    assert get_response.status_code == 404


def test_goal_requires_authentication(client):
    response = client.get("/api/goals")

    assert response.status_code == 401


def test_user_cannot_access_another_users_goal(client):
    user1_token = register_and_login(
        client,
        "goal-user-1@example.com",
    )

    user2_token = register_and_login(
        client,
        "goal-user-2@example.com",
    )

    goal = create_goal(
        client,
        user1_token,
        "Private Goal",
    )

    response = client.get(
        f"/api/goals/{goal['id']}",
        headers=auth_headers(user2_token),
    )

    assert response.status_code == 404