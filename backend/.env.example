APP_NAME=AURA
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://aura_user:aura_password@127.0.0.1:5432/aura_db

# Generate a unique key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-unique-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

CORS_ORIGINS=http://localhost:3000,http://localhost:3001

OPENROUTER_API_KEY=your-openrouter-api-key
AI_MODEL=openai/gpt-4o-mini

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback
