APP_NAME=AURA
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://your_database_user:your_database_password@127.0.0.1:5432/aura_db

# Generate a unique key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-unique-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OTP email provider: console is for development only; production must use smtp.
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=AURA <noreply@example.com>
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Optional dedicated OTP HMAC key. If empty, JWT_SECRET_KEY is used.
OTP_PEPPER=

CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

OPENROUTER_API_KEY=your-openrouter-api-key
AI_MODEL=openai/gpt-4o-mini

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback
